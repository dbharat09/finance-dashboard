rules_version = '2';
// Finance Dashboard — household sharing rules.
// Paste into: Firebase console -> Firestore Database -> Rules -> Publish.
// Only signed-in users who are members of a household can see its data.
// Membership is proven two ways: the creator sits in the household's
// `members` array; anyone who joins with the invite code gets a member
// document at households/{hid}/members/{uid} (created with the code as
// proof — Firestore rules cannot verify arrayUnion transforms, so the
// array-append join pattern does not work and is not used).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && (request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members
            || exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)));
    }

    // uid -> household pointer for the signed-in user
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes: any signed-in user may look up a code (to join) and the
    // household creator may create/delete the code for their own household.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.householdId is string;
      allow delete: if signedIn()
        && resource.data.householdId is string
        && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members;
    }

    match /households/{hid} {
      // Create: creator must be the first member.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];
      // Read/update: members only.
      allow read, update: if isMember(hid);
      allow delete: if false;

      // Join: a signed-in user may create their OWN member document if
      // they present the household's invite code in it.
      match /members/{uid} {
        allow read: if isMember(hid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.code
             == get(/databases/$(database)/documents/households/$(hid)).data.inviteCode;
        allow update, delete: if false;
      }

      match /meta/{docId} {
        allow read, write: if isMember(hid);
      }
      match /expenses/{expenseId} {
        allow read, write: if isMember(hid);
      }
      match /savings/{transferId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
